{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipmworld.com/interview_prep/schema.json",
  "title": "InterviewAnswerFactoryRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "category",
    "question",
    "assumptions",
    "spoken_markdown",
    "spoken_full_script",
    "written_markdown",
    "followups",
    "interviewer_signals",
    "blocks_json",
    "critic_scores",
    "passed"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "description": "Explicit assumptions allowed for numeric or factual specificity.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "spoken_markdown": {
      "type": "string",
      "minLength": 1
    },
    "spoken_full_script": {
      "type": "string",
      "minLength": 1
    },
    "written_markdown": {
      "type": "string",
      "minLength": 1
    },
    "followups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clarification", "depth", "challenge"],
      "properties": {
        "clarification": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "depth": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "challenge": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "interviewer_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "red_flags"],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "secondary": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1 }
        },
        "red_flags": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blocks_json": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Strategy/Goal",
        "Users/Segmentation",
        "Problem Definition",
        "Options & Decision",
        "Architecture/How it works",
        "Execution Plan",
        "Metrics",
        "Risks & Failure Modes",
        "Tradeoffs",
        "Roadmap"
      ],
      "properties": {
        "Strategy/Goal": {
          "type": "string",
          "minLength": 1
        },
        "Users/Segmentation": {
          "type": "string",
          "minLength": 1
        },
        "Problem Definition": {
          "type": "string",
          "minLength": 1
        },
        "Options & Decision": {
          "type": "string",
          "minLength": 1
        },
        "Architecture/How it works": {
          "type": "string",
          "minLength": 1
        },
        "Execution Plan": {
          "type": "string",
          "minLength": 1
        },
        "Metrics": {
          "type": "string",
          "minLength": 1
        },
        "Risks & Failure Modes": {
          "type": "string",
          "minLength": 1
        },
        "Tradeoffs": {
          "type": "string",
          "minLength": 1
        },
        "Roadmap": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "critic_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spoken_score",
        "written_score",
        "score_breakdown",
        "rationale",
        "hard_gates",
        "cycle_count"
      ],
      "properties": {
        "spoken_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "written_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "cycle_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "score_breakdown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spoken", "written"],
          "properties": {
            "spoken": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "structure",
                "decision",
                "architecture",
                "execution",
                "metrics",
                "risks",
                "tradeoffs",
                "spokenness",
                "total"
              ],
              "properties": {
                "structure": { "type": "number", "minimum": 0, "maximum": 100 },
                "decision": { "type": "number", "minimum": 0, "maximum": 100 },
                "architecture": { "type": "number", "minimum": 0, "maximum": 100 },
                "execution": { "type": "number", "minimum": 0, "maximum": 100 },
                "metrics": { "type": "number", "minimum": 0, "maximum": 100 },
                "risks": { "type": "number", "minimum": 0, "maximum": 100 },
                "tradeoffs": { "type": "number", "minimum": 0, "maximum": 100 },
                "spokenness": { "type": "number", "minimum": 0, "maximum": 100 },
                "total": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            },
            "written": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "structure",
                "decision",
                "architecture",
                "execution",
                "metrics",
                "risks",
                "tradeoffs",
                "spokenness",
                "total"
              ],
              "properties": {
                "structure": { "type": "number", "minimum": 0, "maximum": 100 },
                "decision": { "type": "number", "minimum": 0, "maximum": 100 },
                "architecture": { "type": "number", "minimum": 0, "maximum": 100 },
                "execution": { "type": "number", "minimum": 0, "maximum": 100 },
                "metrics": { "type": "number", "minimum": 0, "maximum": 100 },
                "risks": { "type": "number", "minimum": 0, "maximum": 100 },
                "tradeoffs": { "type": "number", "minimum": 0, "maximum": 100 },
                "spokenness": { "type": "number", "minimum": 0, "maximum": 100 },
                "total": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          }
        },
        "rationale": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "hard_gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all_blocks_present",
            "no_empty_blocks",
            "options_min_2_with_choice",
            "execution_has_phases",
            "metrics_has_primary_secondary_guardrails",
            "metrics_success_defined",
            "risks_min_3_with_mitigations",
            "tradeoffs_min_2",
            "spoken_full_script_present_and_continuous",
            "followups_present_and_valid",
            "interviewer_signals_present_and_valid",
            "numbers_only_from_assumptions",
            "no_unsupported_facts",
            "spoken_score_gate",
            "written_score_gate"
          ],
          "properties": {
            "all_blocks_present": { "type": "boolean" },
            "no_empty_blocks": { "type": "boolean" },
            "options_min_2_with_choice": { "type": "boolean" },
            "execution_has_phases": { "type": "boolean" },
            "metrics_has_primary_secondary_guardrails": { "type": "boolean" },
            "metrics_success_defined": { "type": "boolean" },
            "risks_min_3_with_mitigations": { "type": "boolean" },
            "tradeoffs_min_2": { "type": "boolean" },
            "spoken_full_script_present_and_continuous": { "type": "boolean" },
            "followups_present_and_valid": { "type": "boolean" },
            "interviewer_signals_present_and_valid": { "type": "boolean" },
            "numbers_only_from_assumptions": { "type": "boolean" },
            "no_unsupported_facts": { "type": "boolean" },
            "spoken_score_gate": { "type": "boolean" },
            "written_score_gate": { "type": "boolean" }
          }
        },
        "issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "passed": {
      "type": "boolean"
    }
  }
}
